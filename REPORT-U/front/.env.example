# Copia este archivo como .env y ajusta tu entorno. Nunca commitees el .env.
# Expo expone las variables EXPO_PUBLIC_* al bundle (reinicia npm start al cambiar).

# Emulador de Android Studio
EXPO_PUBLIC_API_URL=http://10.0.2.2:5034

# Teléfono físico con Expo Go (misma red Wi-Fi; usa la IP LAN de tu PC)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5034

# Simulador de iOS
# EXPO_PUBLIC_API_URL=http://localhost:5034
