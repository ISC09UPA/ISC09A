# Copia este archivo como .env y ajusta valores. Nunca commitees el .env real.
# Todas estas variables también pueden exportarse directamente en la terminal.

# --- PostgreSQL (debe coincidir con compose.yaml) ---
POSTGRES_USER=reportu
POSTGRES_PASSWORD=reportu_dev
POSTGRES_DB=reportu
POSTGRES_PORT=5432

# --- API: cadena de conexión (formato ConnectionStrings__Clave) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=reportu;Username=reportu;Password=reportu_dev

# --- API: JWT (Key con mínimo 32 caracteres) ---
Jwt__Key=DEV-ONLY-minimo-32-caracteres-reportu-2026
Jwt__Issuer=ReportU
Jwt__Audience=ReportU
Jwt__ExpiresMinutes=720

# --- API: imágenes. Vacío = carpeta local ./uploads (desarrollo sin Azure) ---
AzureBlob__ConnectionString=
AzureBlob__Container=reportu-media

# --- API: entorno y puerto ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5034
