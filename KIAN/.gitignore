# =========================================================
# ImageCards - .gitignore (monorepo: .NET backend + Expo mobile)
# =========================================================

# ---------- Secrets & environment ----------
# Never commit real environment files. Only *.example files are versioned.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pfx
*.p12
*.pem
*.key
secrets.json
appsettings.*.local.json
**/Properties/PublishProfiles/
*.pubxml
*.azurePubxml

# ---------- .NET ----------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
.vs/
TestResults/
[Tt]est[Rr]esult*/
coverage/
coverage*.json
coverage*.xml
*.coverage
*.trx
artifacts/
publish/
*.nupkg
*.snupkg

# ---------- Node / Expo / React Native ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*
# Native folders generated by `expo prebuild` (managed workflow)
mobile/**/ios/
mobile/**/android/
*.jks
*.keystore
*.mobileprovision
*.orig.*

# ---------- Infrastructure ----------
.terraform/
*.tfstate
*.tfstate.*
.azure/
.azurite/

# ---------- IDEs ----------
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
