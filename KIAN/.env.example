# Variables for docker-compose.yml (local development only).
# Copy to .env (git-ignored) and adjust. Never commit .env.

# SA password for the local SQL Server container. Must meet SQL Server complexity rules
# (8+ characters with upper case, lower case, digits and symbols).
MSSQL_SA_PASSWORD=

# Azurite account key. Azurite only accepts its fixed, publicly documented development key:
# https://learn.microsoft.com/azure/storage/common/storage-use-azurite#http-connection-strings
# Copy it from that page. It only works against the local emulator.
AZURITE_ACCOUNT_KEY=

# Host used in image URLs. host.docker.internal works for the browser/emulator on this PC.
# For a physical phone, use this PC's LAN IP (e.g. 192.168.1.50).
BLOB_PUBLIC_HOST=host.docker.internal
