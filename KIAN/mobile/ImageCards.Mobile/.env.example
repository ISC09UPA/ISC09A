# Base URL of the ImageCards API, without a trailing slash. Copy to .env (git-ignored).
# Android emulator: http://10.0.2.2:5080 | iOS simulator / web: http://localhost:5080
# Physical device: http://<this-PC-LAN-IP>:5080 (run the API with --urls http://0.0.0.0:5080)
# EXPO_PUBLIC_* values are embedded in the app bundle: never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:5080
